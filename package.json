{
  "name": "dribbble-discover",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:ui": "node scripts/smoke.mjs",
    "format": "prettier --write src scripts vite.config.ts index.html *.md",
    "format:check": "prettier --check src scripts vite.config.ts index.html *.md"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/damion": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.51.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
